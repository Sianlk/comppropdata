ENV=production
POSTGRES_DB=property_augmented
POSTGRES_USER=property_augmented
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://property_augmented:replace-with-a-strong-database-password@db:5432/property_augmented
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_EXPIRE_HOURS=24
FRONTEND_URL=https://propertydevelopmentaugmented.co.uk
PUBLIC_API_URL=https://api.propertydevelopmentaugmented.co.uk
CORS_ORIGINS=https://propertydevelopmentaugmented.co.uk
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# OS Maps + Places + Features. Keep this key server-side and restrict it in OS Data Hub.
OS_DATA_HUB_API_KEY=
# Browser/embed key should be HTTP-referrer restricted to the production domain.
GOOGLE_MAPS_BROWSER_KEY=
# Server key should be separately restricted for server use/IP where possible.
GOOGLE_MAPS_SERVER_KEY=
# Licensed normalized market/listing, title, planning, sold-price, build-cost and GDV enrichment.
PROPERTYDATA_API_KEY=
# Reserved for authorised HMLR Use land/property data services where applicable.
HMLR_USE_DATA_API_KEY=
# Optional licensed BCIS/cost-provider adapter.
BCIS_API_URL=
BCIS_API_KEY=
COMPANIES_HOUSE_API_KEY=
EPC_API_URL=
EPC_API_TOKEN=
GOOGLE_TRENDS_GEO=GB
GOOGLE_TRENDS_RSS_URL=https://trends.google.com/trending/rss
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
SEMRUSH_API_URL=https://api.semrush.com/
SEMRUSH_API_KEY=
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=Property Development, Augmented
NOTIFY_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_OS=
STRIPE_PRICE_CONSULT=
NEXT_PUBLIC_SITE_URL=https://propertydevelopmentaugmented.co.uk
# Browser calls /backend by default. Configure this only on the Next.js server/container.
PDA_API_ORIGIN=http://api:8080
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_BOOKING_URL=
STORAGE_DIR=/data/storage
PRODUCT_ASSET_DIR=/assets
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
PRIVACY_CONTACT_EMAIL=
